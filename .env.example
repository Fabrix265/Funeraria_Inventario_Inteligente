# Plantilla de variables de entorno. Copia este archivo a ".env" y completa
# los valores reales. NUNCA subas el .env con credenciales al repositorio.

# --- Seguridad -------------------------------------------------------------
# Clave con la que se cifran los archivos antes de subirlos a Google Drive.
# Genera una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Archivo diario de la bitácora ---
# Conserva 30 Excels diarios en la carpeta `bitacora` de Drive.
BITACORA_ARCHIVO_AUTO=true
BITACORA_ARCHIVO_INTERVALO_MIN=60
